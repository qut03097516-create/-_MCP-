# 工具端鉴权：从 JWT 解析 user（不信任智能体传入的 user_id）
# ─────────────────────────────────────────────────────────────────────────────
def resolve_user(access_token: Optional[str],
                 authorization: Optional[str]) -> Optional[Dict[str, Any]]:
    """从 Cookie/Authorization 解析登录用户；失败返回 None。"""
    token = access_token
    if not token and authorization and authorization.startswith('Bearer '):
        token = authorization[7:].strip()
    if not token:
        return None
    try:
        import jwt
        from backend.api.auth import SECRET_KEY, ALGORITHM
        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])
        return {'id': int(payload.get('sub')), 'username': payload.get('username')}
    except Exception:
        return None


