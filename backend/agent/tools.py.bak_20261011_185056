def get_site(params: Dict[str, Any], user: Dict[str, Any],
             trace_id: str = "") -> ToolResult:
    t0 = time.time()
    from utils import site_store
    from utils.data_loader import get_data_files

    site_id = params.get('site_id')
    pv_file = params.get('pv_file')
    name = params.get('name')

    if site_id is not None:
        # 用户电站：本人或分享给我的（工具端权限校验，只读分析）
        site = site_store.get_site_readable(int(site_id), user['id'])
        if not site:
            return fail(EC.E_NOT_FOUND, f"电站 {site_id} 不存在或无权访问",
                        trace_id=trace_id, elapsed_ms=_ms(t0))
        site['kind'] = 'user_site'
        return ok(site, source=['site_config'], trace_id=trace_id, elapsed_ms=_ms(t0))

    if pv_file or name:
        files = []
        try:
            files = get_data_files()
        except Exception:
            files = []
        target = None
        if name:
            for f in files:
                if name in f:
                    target = f
                    break
        else:
            target = pv_file if pv_file in files else next(
                (f for f in files if f.endswith(pv_file) or pv_file in f), None)
        if not target:
            return fail(EC.E_NOT_FOUND,
                        f"未找到数据集站点「{pv_file or name}」，可用站点：{files[:5]}{'…' if len(files) > 5 else ''}",
                        trace_id=trace_id, elapsed_ms=_ms(t0))
        from utils.predictor import parse_pv_filename
        try:
            meta = parse_pv_filename(target)
        except Exception:
            meta = {}
        return ok({
            'kind': 'dataset_site',
            'pv_file': target,
            'display_name': target,
            'provider': {'latitude': meta.get('latitude'),
                         'longitude': meta.get('longitude'),
                         'elevation': meta.get('elevation'),
                         'kwp': meta.get('capacity_kwp', 1.0),
                         'tilt': meta.get('tilt'), 'azimuth': meta.get('azimuth')},
            'model_ready': _dataset_model_ready(target),
        }, source=['data_loader'], trace_id=trace_id, elapsed_ms=_ms(t0))

    return fail(EC.E_BAD_PARAM, "至少提供 site_id / pv_file / name 之一",
                trace_id=trace_id, elapsed_ms=_ms(t0))


def _dataset_model_ready(display_name: str) -> bool:
    import re
    from utils.predictor import get_safe_name
    base = os.path.join('models', get_safe_name(display_name))
    iid_dir = os.path.join(base, 'iid_transformer_lstm')
    return os.path.isdir(iid_dir) and any(
        f.startswith('interval_') and f.endswith('.pt')
        for f in (os.listdir(iid_dir) if os.path.isdir(iid_dir) else []))


# ─────────────────────────────────────────────────────────────────────────────
# 2) check_data_quality —— 数据质量检查
# ─────────────────────────────────────────────────────────────────────────────
def check_data_quality(params: Dict[str, Any], user: Dict[str, Any],
                       trace_id: str = "") -> ToolResult:
    t0 = time.time()
    pv_file = params.get('pv_file')
    site_id = params.get('site_id')
    start_date = params.get('start_date')
    end_date = params.get('end_date')
    capacity_kwp = params.get('capacity_kwp')

    if not pv_file and site_id is None:
        return fail(EC.E_BAD_PARAM, "缺少 pv_file 或 site_id",
                    trace_id=trace_id, elapsed_ms=_ms(t0))

    from utils.data_loader import load_pv_data_by_date_range
    from utils.units import parse_capacity_kwp, power_range_check

    df = None
    err = None
    cap = capacity_kwp
    try:
        if site_id is not None and not pv_file:
            # 用户电站：读上传的发电数据（ts / power_kw → DATATIME / POWER）
            from utils import site_store
            site = site_store.get_site_readable(int(site_id), user['id'])
            if not site:
                return fail(EC.E_NOT_FOUND, f"电站 {site_id} 不存在或无权访问",
                            trace_id=trace_id, elapsed_ms=_ms(t0))
            gen = site_store.get_generation(int(site_id), start_date, end_date)
            if gen is None or gen.empty:
                return fail(EC.E_EMPTY_DATA, "该电站尚未上传发电数据，请先在「数据导入」上传",
                            trace_id=trace_id, elapsed_ms=_ms(t0))
            df = gen.rename(columns={'ts': 'DATATIME', 'power_kw': 'POWER'})
            cap = cap or float(site.get('kwp') or 0) or 1.0
        else:
            # T6 降级：取数失败时尝试全量加载
            try:
                df = load_pv_data_by_date_range(pv_file, start_date, end_date)
            except Exception as e:
                err = str(e)
            if df is None or df.empty:
                # 无日期参数时回退全量
                from utils.data_loader import load_pv_data
                try:
                    df = load_pv_data(pv_file)
                except Exception as e2:
                    err = f"{err or ''}；全量加载失败: {e2}"
                if df is None or df.empty:
                    return fail(EC.E_EMPTY_DATA, f"数据为空：{err}",
                                trace_id=trace_id, elapsed_ms=_ms(t0))
            cap = cap or parse_capacity_kwp(pv_file)

        total = len(df)
        if total == 0:
            return fail(EC.E_EMPTY_DATA, "数据为空", trace_id=trace_id, elapsed_ms=_ms(t0))

        dt_col = 'DATATIME' if 'DATATIME' in df.columns else df.columns[0]
        power_col = 'POWER' if 'POWER' in df.columns else None
        ghi_col = next((c for c in ('辐照度', 'GHI', 'ghi') if c in df.columns), None)

        # 时间间隔（小时）
        ts = df[dt_col]
        dt_series = None
        try:
            dt_series = ts.astype('datetime64[ns]')
            intervals = dt_series.diff().dropna().dt.total_seconds() / 3600
            median_h = float(intervals.median()) if len(intervals) else 0
            max_gap_h = float(intervals.max()) if len(intervals) else 0
        except Exception:
            median_h, max_gap_h = 0.0, 0.0

        # 缺失率
        missing = {}
        if power_col:
            missing['POWER'] = round(float(df[power_col].isna().mean() * 100), 2)
        if ghi_col:
            missing[ghi_col] = round(float(df[ghi_col].isna().mean() * 100), 2)

        # 功率越界（物理口径）
        out_of_range = 0
        if power_col:
            pow_valid = df[power_col].dropna()
            if len(pow_valid):
                mask = pow_valid < 0
                pos = pow_valid[~mask]
                if len(pos):
                    mask = mask.reindex(pow_valid.index).fillna(False)
                # 重新计算正越界
                over = float((pos.astype(float) > cap * 1.2).mean() * 100) if len(pos) else 0.0
                neg = float((pow_valid.astype(float) < 0).mean() * 100) if len(pow_valid) else 0.0
                out_of_range = round(over + neg, 2)

        quality_level = 'good'
        if missing and any(v > 5 for v in missing.values()):
            quality_level = 'warn'
        if out_of_range > 1 or max_gap_h > 6:
            quality_level = 'bad'

        suggestion = []
        if missing and any(v > 5 for v in missing.values()):
            suggestion.append('存在明显缺失，建议回填 NASA POWER 气象或核对原始数据')
        if out_of_range > 1:
            suggestion.append('存在功率越界数据，建议按物理范围（0~1.2×容量）清洗')
        if max_gap_h > 6:
            suggestion.append(f'存在 {max_gap_h:.0f} 小时以上的时间断档，影响模型时序特征')

        return ok({
            'pv_file': pv_file,
            'site_id': site_id,
            'total_records': int(total),
            'start': str(dt_series.min())[:10] if dt_series is not None else '',
            'end': str(dt_series.max())[:10] if dt_series is not None else '',
            'interval_hours': round(median_h, 2) if median_h else 1.0,
            'max_gap_hours': round(max_gap_h, 2) if max_gap_h else 0.0,
            'missing_rate_pct': missing,
            'out_of_range_pct': out_of_range,
            'capacity_kwp': float(cap),
            'quality_level': quality_level,
            'suggestions': suggestion,
        }, source=['site_store.user_generation'] if site_id is not None and not pv_file
                   else ['data/pv_data.duckdb'],
            trace_id=trace_id, elapsed_ms=_ms(t0))
    except Exception as e:
        traceback.print_exc()
        return fail(EC.E_INTERNAL, f'数据质量检查失败: {str(e)}',
                    trace_id=trace_id, elapsed_ms=_ms(t0))


