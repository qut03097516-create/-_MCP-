# 3) get_weather —— 天气获取
# ─────────────────────────────────────────────────────────────────────────────
def get_weather(params: Dict[str, Any], user: Dict[str, Any],
                trace_id: str = "") -> ToolResult:
    t0 = time.time()
    lat = params.get('latitude')
    lon = params.get('longitude')
    start_date = params.get('start_date')
    end_date = params.get('end_date')
    forecast_days = int(params.get('forecast_days') or 7)
    src = params.get('source') or 'auto'

    if lat is None or lon is None:
        return fail(EC.E_BAD_PARAM, '缺少 latitude/longitude',
                    trace_id=trace_id, elapsed_ms=_ms(t0))

    try:
        if start_date and end_date:
            # 历史：NASA POWER 缓存（T6 降级：远程失败但缓存可用）
            from utils.weather import store as wstore
            try:
                df, meta = wstore.get_weather(lat, lon, start_date, end_date)
            except Exception as e:
                from utils.weather.store import get_cached
                df = get_cached(lat, lon, start_date, end_date)
                if df is None or df.empty:
                    return fail(EC.E_UPSTREAM, f'历史天气拉取失败且无缓存: {str(e)}',
                                trace_id=trace_id, elapsed_ms=_ms(t0))
                meta = {'warning': '历史天气远程拉取失败，已用本地缓存'}
            source = ['nasa_power']
        else:
            # 未来：Open-Meteo（重试一次）
            from utils.weather.forecast import fetch_open_meteo_forecast
            last_err = None
            df = None
            for attempt in range(2):
                try:
                    df = fetch_open_meteo_forecast(
                        lat, lon, forecast_days=max(1, min(int(forecast_days), 16)))
                    break
                except Exception as e:
                    last_err = e
                    time.sleep(0.5)
            if df is None or df.empty:
                return fail(EC.E_UPSTREAM,
                            f'Open-Meteo 未来天气获取失败（重试 1 次）: {last_err}',
                            trace_id=trace_id, elapsed_ms=_ms(t0))
            meta = {'source': 'open_meteo'}
            source = ['open_meteo']

        rows = df.to_dict('records')
        # 精简输出：只保留必要列
        cols = [c for c in ('ts', 'ghi', 't2m', 'ws2m', 'DATATIME', '辐照度', '气温', '风速',
                            'pvgis_ghi', 'time') if c in df.columns]
        if not cols and len(rows):
            cols = list(df.columns)
        compact = [{str(c): (None if r[c] is None or (isinstance(r[c], float) and r[c] != r[c]) else r[c])
                    for c in cols} for r in rows]

        return ok({
            'latitude': float(lat),
            'longitude': float(lon),
            'count': int(len(df)),
            'sample': compact[:120],
            'meta': {k: v for k, v in meta.items() if k != 'warning'},
            'warning': meta.get('warning'),
        }, source=source, trace_id=trace_id, elapsed_ms=_ms(t0))
    except Exception as e:
        traceback.print_exc()
        return fail(EC.E_INTERNAL, f'天气获取失败: {str(e)}',
                    trace_id=trace_id, elapsed_ms=_ms(t0))


