def run_tool(name: str, params: Dict[str, Any], user: Dict[str, Any],
             trace_id: str = "") -> ToolResult:
    """按名称执行工具（同步）。"""
    fn = TOOL_FUNCS.get(name)
    if not fn:
        return fail(EC.E_BAD_PARAM, f'未知工具: {name}',
                    trace_id=trace_id, elapsed_ms=0)
    try:
        return fn(params, user, trace_id)
    except Exception as e:
        traceback.print_exc()
        return fail(EC.E_INTERNAL, f'{name} 执行异常: {str(e)}',
                    trace_id=trace_id, elapsed_ms=0)


