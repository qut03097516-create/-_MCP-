def _ms(t0) -> int:
    return int((time.time() - t0) * 1000)


def _safe_num(v, default: float = 0.0) -> float:
    try:
        f = float(v)
        if f != f or abs(f) == float('inf'):
            return default
        return round(f, 4)
    except (TypeError, ValueError):
        return default


def pd_Timestamp(v):
    import pandas as pd
    try:
        return pd.Timestamp(v)
    except Exception:
        return str(v)


def _safe_weather(fetch_fn, *args, **kwargs):
    """天气获取封装：失败返回 (None, error)；成功返回 (df, meta)。"""
    try:
        df, meta = fetch_fn(*args, **kwargs)
        return df, meta
    except Exception as e:
        return None, str(e)
