def extract_coordinates(filename: str):
    """从文件名中提取经纬度信息"""
    pattern = r'Timeseries_(\d+\.\d+)_(\d+\.\d+)_'
    match = re.search(pattern, filename)
    if match:
        lat = float(match.group(1))
        lon = float(match.group(2))
        return lat, lon
    return None, None

